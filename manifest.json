{
  "manifest_version": 3,
  "name": "PeopleNoStudy",
  "version": "0.1.0",
  "description": "右上角小悬浮窗：两轮 AI 识别和求解任意题型，通过 JSON 动作与浏览器原生输入填写，支持编程编辑器，不点击提交。",
  "minimum_chrome_version": "120",
  "permissions": ["activeTab", "scripting", "storage", "debugger", "webNavigation"],
  "optional_host_permissions": ["https://*/*", "http://*/*"],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": { "default_title": "打开 / 关闭 PeopleNoStudy 悬浮窗" },
  "web_accessible_resources": [{ "resources": ["panel.html"], "matches": ["https://*/*", "http://*/*"] }],
  "icons": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "content_security_policy": { "extension_pages": "script-src 'self'; object-src 'none'" }
}
